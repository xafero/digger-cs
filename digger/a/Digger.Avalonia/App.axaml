<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Digger"
             xmlns:tools="clr-namespace:Digger.Avalonia.Tools"
             x:Class="Digger.Avalonia.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <tools:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
</Application>